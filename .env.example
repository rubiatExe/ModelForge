# Runtime
MODELFORGE_ENV=development
MODELFORGE_LOG_LEVEL=INFO
MODELFORGE_MAX_REQUEST_BYTES=16384
MODELFORGE_MAX_CONCURRENT_EVALUATIONS=1
MODELFORGE_ALLOW_TEST_EVALUATION=false
MODELFORGE_ROUTING_POLICY=experiments/results/routing_policy_v1.json
MODELFORGE_TELEMETRY_PATH=telemetry/events.jsonl
MODELFORGE_DATASET_ROOT=data/iam_triage_v1

# Small-model runtime (optional; heuristic-demo is the keyless default)
MODELFORGE_RUNTIME_BACKEND=heuristic
MODELFORGE_SMALL_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# Keep this synchronized with the training manifest's resolved model revision.
MODELFORGE_SMALL_MODEL_REVISION=7ae557604adf67be50417f59c2c2f167def9a775
MODELFORGE_ADAPTER_PATH=
MODELFORGE_ADAPTER_REVISION=
MODELFORGE_DEVICE=auto
MODELFORGE_LOCAL_FILES_ONLY=false

# Frontier adapter (optional). Do not commit a real key.
MODELFORGE_FRONTIER_BASE_URL=
MODELFORGE_FRONTIER_MODEL=
MODELFORGE_FRONTIER_API_KEY=
MODELFORGE_FRONTIER_INPUT_USD_PER_MILLION=0
MODELFORGE_FRONTIER_OUTPUT_USD_PER_MILLION=0
MODELFORGE_FRONTIER_PRICING_SOURCE=
MODELFORGE_FRONTIER_PRICING_AS_OF=
MODELFORGE_FRONTIER_TIMEOUT_SECONDS=30
